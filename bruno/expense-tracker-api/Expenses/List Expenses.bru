meta {
  name: List Expenses
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/expenses
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Returns the authenticated user's expenses, newest first.
  Requires a valid JWT. Returns 401 when missing and 403 when invalid or expired.
}
