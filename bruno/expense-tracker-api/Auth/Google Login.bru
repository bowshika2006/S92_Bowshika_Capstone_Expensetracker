meta {
  name: Google Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/google
  body: json
  auth: none
}

body:json {
  {
    "credential": "replace-with-google-id-token"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Exchanges a Google Identity Services ID token for an Expense Tracker JWT.
  Replace credential with a real Google ID token; successful login saves the JWT to the active environment.
}
