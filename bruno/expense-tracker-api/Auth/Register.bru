meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Alex Student",
    "email": "alex@example.com",
    "password": "change-me"
  }
}

docs {
  Creates a local account. Name, email, and password are required.
  Returns 201 with the new user's id, name, and email. Duplicate email returns 400.
}
