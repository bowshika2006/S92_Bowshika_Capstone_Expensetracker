meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "alex@example.com",
    "password": "change-me"
  }
}

script:post-response {
  if (res.status === 200 && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}

docs {
  Authenticates a local account and returns a JWT valid for one hour.
  A successful response saves the token to the active Bruno environment for authenticated requests.
}
